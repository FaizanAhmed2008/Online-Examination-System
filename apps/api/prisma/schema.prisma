// ---------------------------------------------------------------------------
// Online Examination System — data layer
//
// Sprint 2 (foundation & auth) adds the two entities authentication owns:
// User and Session. The remaining PRD §14 entities (Subject, Question, Exam,
// Attempt, ...) arrive with the feature that needs them, so schema and
// migrations stay reviewable instead of being a speculative up-front guess.
//
// Workflow: see docs/development-conventions.md, section "Database".
// ---------------------------------------------------------------------------

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
  runtime             = "nodejs"
}

datasource db {
  provider = "postgresql"
}

/// PRD §5. Fixed for the MVP; a user has exactly one role.
enum Role {
  STUDENT
  FACULTY
  ADMIN
}

/// A deactivated user keeps all historical data (attempts, results) but can no
/// longer sign in. Users are deactivated, never deleted.
enum UserStatus {
  ACTIVE
  INACTIVE
}

/// PRD §9: the MVP ships single-correct multiple choice only. The enum exists so
/// another objective type can be added later without a migration of every row.
enum QuestionType {
  SINGLE_CHOICE
}

/// A question or subject is archived rather than deleted once anything refers
/// to it, so historic exams and results keep their content.
enum SubjectStatus {
  ACTIVE
  INACTIVE
}

enum QuestionStatus {
  ACTIVE
  INACTIVE
}

/// PRD §15. A draft is editable by its owner; publishing hands the exam to
/// students. Deliberately coarse for the MVP: a scheduled window (openAt /
/// closeAt) arrives with the attempt feature, not before.
enum ExamStatus {
  DRAFT
  PUBLISHED
}

model User {
  id       String @id @default(uuid())
  name     String
  /// Always stored lower-cased and trimmed, so sign-in is case-insensitive.
  email    String @unique
  /// scrypt digest, never a plaintext or reversibly-encoded password.
  passwordHash String
  role     Role       @default(STUDENT)
  status   UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  sessions Session[]
  questions Question[]
  exams    Exam[]
  attempts Attempt[]

  @@map("users")
}

/// PRD §14. Admin-managed grouping for questions and exams.
model Subject {
  id          String        @id @default(uuid())
  name        String
  /// Short code shown to students, unique across the system.
  code        String        @unique
  description String?
  status      SubjectStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  questions Question[]
  exams    Exam[]

  @@map("subjects")
}

/// PRD §14. A single-correct objective question, owned by the faculty member
/// who created it. Ownership is what authorises edits and deletes.
model Question {
  id          String         @id @default(uuid())
  subjectId   String
  createdById String
  text        String
  type        QuestionType   @default(SINGLE_CHOICE)
  marks       Int
  /// Shown only after an attempt is finalised (PRD §21).
  explanation String?
  status      QuestionStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  subject   Subject         @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  createdBy User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  options   QuestionOption[]
  exams     ExamQuestion[]
  answers   AttemptAnswer[]

  @@index([subjectId])
  @@index([createdById])
  @@index([status])

  @@map("questions")
}

/// One selectable answer. Exactly one per question is correct; the invariant is
/// enforced in the service layer, because a database-level guarantee would need
/// a hand-written partial unique index.
model QuestionOption {
  id         String   @id @default(uuid())
  questionId String
  text       String
  isCorrect  Boolean  @default(false)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  AttemptAnswer[]

  @@index([questionId])

  @@map("question_options")
}

/// PRD §14, FR-14. An assessment owned by the faculty member who built it.
/// The question set lives in `ExamQuestion` so one exam can order its questions
/// and value them independently of the question bank.
model Exam {
  id              String     @id @default(uuid())
  subjectId       String
  createdById     String
  title           String
  /// Optional student-facing brief shown before an attempt starts.
  instructions    String?
  durationMinutes Int
  status          ExamStatus @default(DRAFT)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  subject   Subject        @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  createdBy User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  questions ExamQuestion[]
  attempts  Attempt[]

  @@index([createdById])
  @@index([subjectId])
  @@index([status])

  @@map("exams")
}

/// Join row giving an exam its question order and the marks that question
/// carries *in that exam*.
///
/// Marks are copied from the question rather than read through it: editing a
/// question in the bank later must not silently change a published exam's
/// total. `position` is the order a student sees, and is unique per exam.
model ExamQuestion {
  id         String @id @default(uuid())
  examId     String
  questionId String
  position   Int
  marks      Int

  exam     Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([examId, position])
  @@index([examId])
  @@index([questionId])

  @@map("exam_questions")
}

/// PRD §16. One student's run at one exam.
///
/// The MVP allows a single attempt per student per exam: the unique pair below is
/// what makes "start" idempotent, so a double click or a refresh resumes the
/// same attempt instead of eating a second one. `expiresAt` is fixed when the
/// attempt starts and is the only clock the client trusts for the countdown.
model Attempt {
  id          String        @id @default(uuid())
  examId      String
  studentId   String
  status      AttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime      @default(now())
  expiresAt   DateTime
  submittedAt DateTime?
  /// Marks awarded, written once on submission.
  score       Int?

  exam    Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  student User            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers AttemptAnswer[]

  @@unique([examId, studentId])
  @@index([studentId])

  @@map("attempts")
}

/// PRD §16. What the student picked for one question.
///
/// `isCorrect` and `marksAwarded` stay null until submission, so a half-finished
/// attempt cannot leak the answer key to the client.
model AttemptAnswer {
  id               String   @id @default(uuid())
  attemptId        String
  questionId       String
  selectedOptionId String?
  isCorrect        Boolean?
  marksAwarded     Int?

  attempt  Attempt         @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question       @relation(fields: [questionId], references: [id], onDelete: Restrict)
  option   QuestionOption? @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@unique([attemptId, questionId])
  @@index([questionId])

  @@map("attempt_answers")
}

/// An attempt is either being sat or has been finalised. There is no third state
/// for the MVP: grading happens on submit, so nothing is left half-graded.
enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

/// An opaque server-side session. The cookie carries a random 32-byte token;
/// only its SHA-256 digest is stored, so a database leak cannot be replayed as a
/// login. Revoking the row logs the user out everywhere immediately.
model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])

  @@map("sessions")
}
