{
  "name": "@oes/api",
  "version": "0.1.0",
  "private": true,
  "description": "Online Examination System \u2014 REST API (Express + TypeScript).",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "prisma generate && vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/seed.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@oes/shared": "*",
    "@prisma/client": "^7.10.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "zod": "^4.6.5",
    "@prisma/adapter-pg": "^7.10.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vitest": "^5.0.2",
    "@types/pg": "^8.16.0"
  }
}
