# ---------------------------------------------------------------------------
# Copy to `.env` in the repository root and fill in real values.
# `.env` is git-ignored. Never commit real credentials.
# ---------------------------------------------------------------------------

# Runtime environment: development | test | production
NODE_ENV=development

# HTTP port for the API server (apps/api)
PORT=4000

# PostgreSQL connection string used by Prisma (apps/api)
# Local docker compose (see docker/docker-compose.yml):
DATABASE_URL="postgresql://oes:oes@localhost:5432/oes?schema=public"

# Origins allowed to call the API from a browser (comma separated)
CORS_ORIGIN=http://localhost:5173

# Lifetime of a login session in hours (1-720). A session is a row in the
# `sessions` table; the browser only ever holds an httpOnly cookie.
SESSION_TTL_HOURS=12

# Password for the accounts created by `npm run db:seed` (development only).
# The seed refuses to run without it, so no well-known default credential can
# reach a shared environment. Minimum 8 characters.
# SEED_USER_PASSWORD=change-me-before-seeding

# Log level for the structured API logger: debug | info | warn | error
LOG_LEVEL=info

# Base URL of the API, used by the web app (Vite env prefix: VITE_)
VITE_API_BASE_URL=http://localhost:4000
